# Copy to .env and fill in values. NEVER commit .env.

# Django core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.development

# Hosts (comma-separated). Add your ngrok domain here during development.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (defaults to local SQLite when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/store

# Public base URL (ngrok URL in dev, real domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# Production-only
# SECURE_SSL_REDIRECT=1
