# Copy to .env and fill in values. NEVER commit .env.

# Django core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.development

# Hosts (comma-separated). Add your ngrok domain here during development.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (defaults to local SQLite when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/store

# Public base URL (ngrok URL in dev, real domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# Production-only
# SECURE_SSL_REDIRECT=1

# ===== Google Drive (catálogo) =====
# 1) Crie uma conta de serviço no Google Cloud e ative a "Google Drive API"
# 2) Baixe o JSON da chave e coloque o caminho abaixo
# 3) Compartilhe a pasta raiz do catálogo com o e-mail da conta de serviço (Leitor)
# 4) Compartilhe as fotos como "Qualquer pessoa com o link" para aparecerem no site
GOOGLE_SERVICE_ACCOUNT_FILE=API AQUI   # ex.: /caminho/service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=API AQUI   # ID da pasta (parte final da URL do Drive)

# ===== Gemini via LangChain (descrições automáticas) =====
GEMINI_API_KEY=API AQUI                # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash

# ===== WhatsApp da loja =====
WHATSAPP_NUMBER=5511954294886
