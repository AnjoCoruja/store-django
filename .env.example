# Copy to .env and fill in values. NEVER commit .env.

# Django core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.development

# Hosts (comma-separated). Add your ngrok domain here during development.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (defaults to local SQLite when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/store

# Public base URL (ngrok URL in dev, real domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# Production-only
# SECURE_SSL_REDIRECT=1

# ===== Google Drive (catálogo) =====
# Pasta REDBLUELINE (já configurada como padrão no projeto; aceita ID ou link):
GOOGLE_DRIVE_ROOT_FOLDER_ID=17aVjdXzO65x1LbpCclqJTzhX9zRJnWb0
# Sem credencial, o site lê a pasta pública ("Qualquer pessoa com o link").
# Para usar a API oficial, preencha UMA das opções abaixo:
#  a) Chave de API (Google Cloud > Credenciais > Criar chave de API; ative a "Google Drive API")
GOOGLE_API_KEY=API AQUI
#  b) Conta de serviço (para pasta privada: compartilhe a pasta com o e-mail da conta)
GOOGLE_SERVICE_ACCOUNT_FILE=API AQUI   # ex.: /caminho/service-account.json

# ===== Gemini via LangChain (descrições automáticas) =====
GEMINI_API_KEY=API AQUI                # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.8-flash

