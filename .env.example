# Copy to .env and fill in values. NEVER commit .env.

# Django core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings.development

# Hosts (comma-separated). Add your ngrok domain here during development.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Database (defaults to local SQLite when unset)
# DATABASE_URL=postgres://user:password@localhost:5432/store

# Public base URL (ngrok URL in dev, real domain in prod)
PUBLIC_BASE_URL=http://localhost:8000

# Production-only
# SECURE_SSL_REDIRECT=1

# Google Drive sync (python manage.py sync_drive --watch)
# ID of the root folder: each sub-folder is a category, each photo a product.
DRIVE_ROOT_FOLDER_ID=
# Service account key (share the Drive folder with the service account e-mail).
# Use a file path OR the raw JSON (useful on PaaS). Never commit the key.
GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_SYNC_INTERVAL=60

# AI captions (optional, any OpenAI-compatible API). Without it a template caption is used.
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
